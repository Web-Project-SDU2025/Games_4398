# 前端环境变量配置示例

# API 基础路径
VITE_API_BASE_URL=http://localhost:8080/api

# 应用标题
VITE_APP_TITLE=4398游戏管理系统

# 是否启用 Mock 数据
VITE_USE_MOCK=false

# 示例说明：
# 1. 开发环境：复制此文件并重命名为 .env.development
# 2. 生产环境：复制此文件并重命名为 .env.production
# 3. 修改对应环境的配置值
# 4. 不要将 .env.*.local 文件提交到 Git（已在 .gitignore 中）

# Vite 环境变量使用说明：
# - 只有以 VITE_ 开头的变量才会暴露给客户端代码
# - 在代码中通过 import.meta.env.VITE_xxx 访问
# - .env.development 用于开发环境（npm run dev）
# - .env.production 用于生产环境（npm run build）

# 开发环境配置示例（.env.development）
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_USE_MOCK=false

# 生产环境配置示例（.env.production）
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# VITE_USE_MOCK=false
